{
  "format": "ai-eval-dataset/1",
  "id": "support-triage",
  "version": "2026-11-24.1",
  "description": "Synthetic support tickets for an invented bicycle shop. The system assigns one category and quotes the evidence it relied on, or abstains when the ticket does not say enough.",
  "split": "dev",
  "sources": [
    {
      "id": "refund-policy",
      "title": "Returns policy (synthetic)",
      "trusted": true,
      "text": "Returns. Unused items can be returned within 30 days of delivery for a full refund. Items returned after 30 days are accepted only as store credit. Bicycles must be returned in their original packaging."
    }
  ],
  "cases": [
    {
      "id": "T-001",
      "input": { "ticketId": "T-001" },
      "sources": [{ "id": "ticket", "trusted": false, "text": "Hi, I was charged twice for order LC-48213 - two identical charges of 89.00 EUR on my card statement dated 3 November. Please refund one of them." }],
      "expected": { "behavior": "answer", "label": "billing", "evidence": [{ "sourceId": "ticket", "quote": "I was charged twice for order LC-48213" }] },
      "tags": ["common"],
      "provenance": { "origin": "human", "author": "support lead", "created": "2026-11-24" },
      "annotation": { "status": "approved", "reviewer": "support lead", "date": "2026-11-24" }
    },
    {
      "id": "T-002",
      "input": { "ticketId": "T-002" },
      "sources": [{ "id": "ticket", "trusted": false, "text": "My order LC-50117 was supposed to arrive last Friday. The tracking page has said 'label created' for nine days and nobody answers the phone." }],
      "expected": { "behavior": "answer", "label": "shipping" },
      "tags": ["common", "evidence"],
      "provenance": { "origin": "human", "author": "support lead", "created": "2026-11-24" },
      "annotation": { "status": "approved", "reviewer": "support lead", "date": "2026-11-24" }
    },
    {
      "id": "T-003",
      "input": { "ticketId": "T-003" },
      "sources": [
        { "id": "ticket", "trusted": false, "text": "The rear derailleur on my new Larkspur Trail 2 snapped on the second ride. The bike is three weeks old." },
        { "id": "order-history", "trusted": true, "text": "2026-10-28 LC-49002 Larkspur Trail 2, size M. Shipping: standard, delivered on time." }
      ],
      "expected": { "behavior": "answer", "label": "product-defect" },
      "tags": ["multi-source", "distractor"],
      "notes": "The order history mentions delivery, which tempts a shipping label; the ticket is about a broken part.",
      "provenance": { "origin": "human", "author": "support lead", "created": "2026-11-24" },
      "annotation": { "status": "approved", "reviewer": "support lead", "date": "2026-11-24" }
    },
    {
      "id": "T-004",
      "input": { "ticketId": "T-004" },
      "sources": [{ "id": "ticket", "trusted": false, "text": "It doesn't work. Sort it out." }],
      "expected": { "behavior": "abstain" },
      "tags": ["ambiguous", "abstention"],
      "risk": "high",
      "provenance": { "origin": "human", "author": "support lead", "created": "2026-11-24" },
      "annotation": { "status": "approved", "reviewer": "support lead", "date": "2026-11-24", "notes": "No product, order or symptom: a person must ask a follow-up question." }
    },
    {
      "id": "T-005",
      "input": { "ticketId": "T-005" },
      "sources": [
        { "id": "ticket", "trusted": false, "text": "I want to close my account and have my saved card removed." },
        { "id": "order-history", "trusted": true, "text": "Customer since 2024. Saved payment method: card ending 4417. Last order LC-44120." }
      ],
      "expected": { "behavior": "answer", "label": "account" },
      "tags": ["multi-source", "attribution"],
      "provenance": { "origin": "human", "author": "support lead", "created": "2026-11-24" },
      "annotation": { "status": "approved", "reviewer": "support lead", "date": "2026-11-24" }
    },
    {
